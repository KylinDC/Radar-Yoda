{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-yoda-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  // Required by fetch-to-node (it uses node:stream / node:buffer) and by
  // @mastra/core, which imports fs/promises, os and path at module scope.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // The custom domain is the public entry point. The *.workers.dev hostname is
  // kept alive only because the CI smoke test needs it: the zone's security
  // rules reject GitHub Actions runner IPs with a 403 before the request ever
  // reaches the Worker, and workers.dev is not behind that zone.
  "workers_dev": true,
  // `custom_domain: true` makes wrangler create the DNS record and the TLS
  // certificate itself, so the zone must be active on this same account.
  "routes": [
    {
      "pattern": "radar-yoda.121314.best",
      "custom_domain": true
    }
  ],
  // @mastra/mcp runs `createRequire(import.meta.url)` at module scope to probe
  // for the optional `dd-trace` Datadog tracer. workerd leaves import.meta.url
  // undefined, so that call throws and the whole Worker fails to start.
  // Substituting any valid file URL is enough: the probe itself never runs
  // here, and mastra/core already does the same `|| "file://"` fallback.
  "define": {
    "import.meta.url": "\"file:///worker.js\""
  },
  // Replaces the in-memory rate limiter from the Node server. Counters are
  // per Cloudflare location, not global. `period` may only be 10 or 60.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "6001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
