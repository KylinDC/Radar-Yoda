{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    // Honour .gitignore, so build output (dist/, .wrangler/) is never checked.
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "**",
      // Generated by `npm run gen:volumes` — never hand-edited.
      "!src/generated",
      // Upstream radar data. biome would collapse the multi-line string
      // arrays, which is a formatting change to data, not to code.
      "!tech-radar-json-data",
      // Machine-local Claude Code settings.
      "!.claude"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Matches the existing house style; the untouched files cluster at 89–103.
    "lineWidth": 100
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      // The codebase omits semicolons throughout.
      "semicolons": "asNeeded"
    }
  },

  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            // vitest's `expect` does not narrow types the way an `assert`
            // would, so `x!` after `expect(x).toBeDefined()` is the idiomatic
            // way to carry the narrowed type into the assertions that follow.
            // Still enforced everywhere outside tests/.
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
